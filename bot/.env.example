# Copy to bot/.env and fill in. Never commit the real .env.
DISCORD_TOKEN=paste-bot-token-here
GUILD_ID=your-server-id
APPROVALS_CHANNEL_ID=channel-id-of-#approvals
ALERTS_CHANNEL_ID=channel-id-of-#alerts
# Step 2: AI drafting. Get a key at https://console.anthropic.com (Settings → API keys).
ANTHROPIC_API_KEY=paste-anthropic-key-here
# Sale detection from email (SALES-EMAIL.md). Use the inbox the marketplaces email when something sells.
# Gmail: turn on 2-Step Verification, then Google Account → Security → App passwords.
# Leave these blank to turn it off (then record every sale with /sold).
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_FOLDER=INBOX
# Nightly backups go to data/backups/. To also copy them (and photos) off this computer, mount a
# folder in docker-compose.yml, e.g. OneDrive, and point this at it (see README "Backups").
# BACKUP_OFFSITE=/app/offsite
